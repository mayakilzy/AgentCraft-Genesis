# Local-only env. Copy to .env.local and adjust.
# GENESIS_API_KEY must match an entry in the gateway's GENESIS_API_KEYS JSON map.
GENESIS_HTTP_URL=http://127.0.0.1:4180
GENESIS_API_KEY=g7-controlled-key-local

# Operator PIN — sole trust boundary for BFF access.
# In dev mode (NODE_ENV != production), if unset, defaults to 'dev-local-pin'.
# In production, MUST be set to a strong random value (>= 32 chars) or
# /api/auth/login fails closed (returns 401 to all callers).
GENESIS_OPERATOR_PIN=dev-local-pin

# HMAC secret for signing BFF cookies. In dev mode, if unset, a per-process
# random secret is used (cookies do not survive restart). In production,
# MUST be set to a stable random value (>= 32 chars).
GENESIS_BFF_SECRET=

# Bounded upstream timeout (ms). Bounded 1000-60000.
GENESIS_BFF_TIMEOUT_MS=30000

NEXT_PUBLIC_GENESIS_MODE=controlled
